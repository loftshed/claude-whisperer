#!/bin/bash
# claude-migrate: move your Claude Code setup to a new Mac.
#
#   claude-migrate export [-o DIR] [--no-history] [--no-encrypt] [--passphrase-file FILE] [--dry-run]
#   claude-migrate import ARCHIVE|DIR [--yes] [--dry-run] [--passphrase-file FILE]
#   claude-migrate doctor
#
# export  packs every Claude Code profile (~/.claude, ~/.claude-*), ~/.claude.json, the ~/.agents
#         skill hub, agent-executor and ai-usage config, the Claude launchers in ~/.local/bin and
#         the Claude desktop MCP config into one archive, encrypted unless --no-encrypt. Memory
#         always comes along; transcripts (claude --resume), prompt history and /rewind
#         checkpoints do too unless --no-history. Caches, logs, virtualenvs and backup copies stay
#         behind; --dry-run lists everything with sizes. The archive carries this script and a
#         RESTORE.md checklist. Default output directory: your home directory.
# import  unpacks an archive on the new Mac, rewrites paths if the home directory changed, copies
#         whatever it would overwrite to ~/.local/share/claude-migrate/backups/<time>, merges the
#         archive into $HOME, then runs doctor. Logins stay in the old Mac's Keychain.
# doctor  lists what is still missing: Claude Code itself, profile logins, repos to clone, links
#         with no target, and programs your hooks, status line and MCP servers call.
#
# Needs only what a fresh Mac ships with: bash 3.2, bsdtar, sed, grep, awk and LibreSSL.
set -euo pipefail
export LC_ALL=C

VERSION=1.0.0
FORMAT=1
STATE_DIR="$HOME/.local/share/claude-migrate"
CIPHER=(-aes-256-cbc -md sha256 -pbkdf2 -iter 200000)
SECRET_RE='sk-ant-[A-Za-z0-9_-]{20,}|gh[pousr]_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{40,}|glpat-[A-Za-z0-9_-]{20}|xox[abprs]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35}|-----BEGIN [A-Z ]*PRIVATE KEY-----'
# Claude-related files outside the profile directories, relative to $HOME.
EXTRA_ITEMS=(
  .claude.json
  .agents
  .config/agent-executor
  .config/ai-usage
  "Library/Application Support/Claude/claude_desktop_config.json"
  .local/bin/plaude
)
SHELL_FILES=(.zshrc .zshenv .zprofile .bashrc .bash_profile)

die() { printf 'claude-migrate: %s\n' "$*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }
usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; }

tildify() {
  case $1 in
    "$HOME") printf '~\n' ;;
    "$HOME"/*) printf '~/%s\n' "${1#"$HOME"/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

untildify() {
  case $1 in
    '~') printf '%s\n' "$HOME" ;;
    '~/'*) printf '%s/%s\n' "$HOME" "${1#\~/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

human_kb() {
  awk -v k="$1" 'BEGIN { split("K M G T", u, " "); i = 1
    while (k >= 1024 && i < 4) { k /= 1024; i++ }
    fmt = (i == 1 ? "%d%s\n" : "%.1f%s\n"); printf fmt, k, u[i] }'
}

# Programs every Mac has; not worth listing as dependencies.
is_system_path() {
  case $1 in
    "$HOME"/*) return 1 ;;
    /bin/* | /sbin/* | /usr/bin/* | /usr/sbin/* | /usr/lib/* | /usr/libexec/* | /dev/* | /System/* | \
      /tmp/* | /private/* | /var/* | /etc/*) return 0 ;;
  esac
  return 1
}

kb_of() { { du -sk "$1" 2>/dev/null || true; } | awk '{ s += $1 } END { print s + 0 }'; }

# Project directories are named after the project path with every non-alphanumeric turned into "-".
encode_path() { printf '%s' "$1" | sed 's/[^A-Za-z0-9]/-/g'; }

# ~/.claude plus any ~/.claude-* directory (other CLAUDE_CONFIG_DIR profiles), relative to $HOME.
profile_dirs() {
  local d
  for d in "$HOME/.claude" "$HOME"/.claude-*; do
    if [ -d "$d" ] && [ ! -L "$d" ]; then printf '%s\n' "${d#"$HOME"/}"; fi
  done
}

# Why an entry at the top of a profile directory stays behind; prints nothing to keep it.
skip_reason() {
  case $1 in
    backups | *.backup | *.backup.* | *.bak | *.bak-* | *-bak | *-bak.* | *-bak-*)
      echo "old backup copy" ;;
    cache | debug | downloads | ide | jobs | session-env | sessions | shell-snapshots | statsig | telemetry | \
      daemon | bridge-spawn | .cc-writes | *.lock | daemon.log | daemon.status.json | .last-cleanup | \
      .last-update-result.json | mcp-needs-auth-cache.json | stats-cache.json | .DS_Store)
      echo "runtime state; Claude Code recreates it" ;;
    policy-limits.json* | remote-settings.json)
      echo "set by your organization; fetched again after login" ;;
  esac
  if [ "$NO_HISTORY" = 1 ]; then
    case $1 in
      history.jsonl) echo "--no-history: prompt history (up arrow)" ;;
      file-history) echo "--no-history: /rewind checkpoints" ;;
      paste-cache) echo "--no-history: large pastes that prompt history points to" ;;
      tasks | todos) echo "--no-history: per-session task lists" ;;
    esac
  fi
}

# ---------------------------------------------------------------------------------------- export

add_item() { printf '%s\n' "$1" >>"$work/items"; }
add_skip() { printf '%s\t%s\t%s\n' "$1" "$2" "$3" >>"$work/skipped.tsv"; }

collect() {
  local p e name reason d kb
  : >"$work/items"
  : >"$work/skipped.tsv"
  : >"$work/excludes"
  NESTED_KB=0
  for p in $(profile_dirs); do
    for e in "$HOME/$p"/* "$HOME/$p"/.[!.]* "$HOME/$p"/..?*; do
      if [ ! -e "$e" ] && [ ! -L "$e" ]; then continue; fi
      name=${e##*/}
      reason=$(skip_reason "$name")
      if [ -n "$reason" ]; then
        add_skip "$(kb_of "$e")" "$p/$name" "$reason"
      elif [ "$NO_HISTORY" = 1 ] && [ "$name" = projects ] && [ ! -L "$e" ]; then
        for d in "$e"/*/memory; do
          if [ -d "$d" ]; then add_item "${d#"$HOME"/}"; fi
        done
        add_skip "$(kb_of "$e")" "$p/projects" "--no-history: transcripts for claude --resume (memory kept)"
      else
        add_item "$p/$name"
      fi
    done
    # Virtualenvs hold absolute paths and platform binaries; their plugins rebuild them.
    while IFS= read -r d; do
      printf './%s\n' "${d#"$HOME"/}" >>"$work/excludes"
      kb=$(kb_of "$d")
      NESTED_KB=$((NESTED_KB + kb))
      add_skip "$kb" "${d#"$HOME"/}" "Python virtualenv; its plugin recreates it"
    done < <(find "$HOME/$p" -name node_modules -prune -o -type d -name '*venv' -print -prune 2>/dev/null)
    printf '%s\n' "./$p/*.log" "./$p/*.err" "./$p/security/log.txt*" >>"$work/excludes"
    kb=$(find "$HOME/$p" \( -name '*.log' -o -name '*.err' -o -path '*/security/log.txt*' \) -type f \
      -exec du -k {} + 2>/dev/null | awk '{ s += $1 } END { print s + 0 }') || true
    if [ "$kb" -gt 0 ]; then
      NESTED_KB=$((NESTED_KB + kb))
      add_skip "$kb" "$p/**/*.log, *.err" "log files"
    fi
  done
  printf '%s\n' '*/.DS_Store' >>"$work/excludes"
  for e in "${EXTRA_ITEMS[@]}" "$HOME"/.local/bin/*claude*; do
    e=${e#"$HOME"/}
    if [ "$e" = .local/bin/claude ]; then continue; fi # the CLI itself; the installer brings it
    if [ -e "$HOME/$e" ] || [ -L "$HOME/$e" ]; then add_item "$e"; fi
  done
}

under_items() {
  local item
  while IFS= read -r item; do
    case $1 in "$HOME/$item" | "$HOME/$item"/*) return 0 ;; esac
  done <"$work/items"
  return 1
}

# Paths the setup depends on outside the archive: link targets, directory marketplaces, and
# programs named by hooks, the status line and user-level MCP servers.
discover_dependencies() {
  local item link t abs c d top remote branch installs
  : >"$work/candidates"
  : >"$work/broken.tsv"
  while IFS= read -r item; do
    find "$HOME/$item" -name node_modules -prune -o -type l -print 2>/dev/null || true
  done <"$work/items" | while IFS= read -r link; do
    t=$(readlink "$link")
    case $t in
      /*) abs=$t ;;
      *) abs=$(cd -P "$(dirname "$link")" 2>/dev/null && cd -P "$(dirname "$t")" 2>/dev/null &&
        printf '%s/%s' "$(pwd)" "${t##*/}") || abs="$(dirname "$link")/$t" ;;
    esac
    if [ ! -e "$link" ]; then printf '%s\t%s\n' "${link#"$HOME"/}" "$t" >>"$work/broken.tsv"; fi
    printf '%s\n' "$abs" >>"$work/candidates"
  done
  referenced_paths >>"$work/candidates"

  : >"$work/external.txt"
  sort -u "$work/candidates" | while IFS= read -r c; do
    if under_items "$c" || is_system_path "$c"; then continue; fi
    case $c in "$HOME"/.claude | "$HOME"/.claude/* | "$HOME"/.claude-*) continue ;; esac # left out on purpose
    d=$c
    while [ ! -d "$d" ] && [ "$d" != / ] && [ "$d" != . ]; do d=$(dirname "$d"); done
    top=$(git -C "$d" rev-parse --show-toplevel 2>/dev/null) || top=
    # Only your own clones count as repos; /opt/homebrew is a git checkout too.
    case $top in
      "$HOME"/*) printf '%s\n' "$top" ;;
      *) if [ -e "$c" ]; then tildify "$c" >>"$work/external.txt"; fi ;;
    esac
  done | sort -u | while IFS= read -r top; do
    remote=$(git -C "$top" remote get-url origin 2>/dev/null) || remote=-
    branch=$(git -C "$top" symbolic-ref --short HEAD 2>/dev/null) || branch=-
    installs=$(git -C "$top" ls-files '*install.sh' 2>/dev/null | grep -v uninstall | tr '\n' ' ' | sed 's/ $//') || true
    printf '%s\t%s\t%s\t%s\n' "$(tildify "$top")" "$remote" "$branch" "${installs:--}"
  done >"$work/repos.tsv"
}

# Absolute paths named in settings "command" entries, directory marketplaces and user MCP servers.
referenced_paths() {
  local p f
  for p in $(profile_dirs); do
    for f in "$HOME/$p/settings.json" "$HOME/$p/settings.local.json" "$HOME/$p/plugins/known_marketplaces.json"; do
      if [ -f "$f" ]; then grep -hE '"(command|path)"' "$f" || true; fi
    done
    for f in "$HOME/$p/.claude.json" "$HOME/.claude.json"; do
      if [ -f "$f" ]; then sed -n '/^  "mcpServers": {$/,/^  }/p' "$f"; fi
    done
  done | sed -E 's#[a-z]+://[^" ]*##g' | grep -oE '(\$HOME|~)?/[A-Za-z0-9._@+-][A-Za-z0-9._@+/-]*' |
    sed -e "s#^\\\$HOME/#$HOME/#" -e "s#^~/#$HOME/#" | sort -u || true
}

scan_secrets() {
  local f kinds
  {
    while IFS= read -r f; do printf '%s\0' "$HOME/$f"; done <"$work/items"
    printf '%s\0' "$meta/extras"
  } | xargs -0 grep -rIlE --exclude-dir=node_modules --exclude-dir='*venv' --exclude='*.log' \
    -e "$SECRET_RE" 2>/dev/null | while IFS= read -r f; do
    kinds=$(grep -ohE -e "$SECRET_RE" "$f" |
      sed -E 's/^(sk-ant-|gh[pousr]_|github_pat_|glpat-|xox[abprs]-|AKIA|AIza|-----BEGIN).*/\1/' |
      sort -u | tr '\n' ' ' | sed 's/ $//') || true
    f=${f#"$meta"/}
    printf '%s\t%s\n' "$(tildify "$f")" "$kinds"
  done >"$work/secrets.tsv" || true
}

copy_shell_files() {
  local f
  for f in "${SHELL_FILES[@]}"; do
    if [ -f "$HOME/$f" ]; then cp -p "$HOME/$f" "$meta/extras/shell/$f"; fi
  done
}

# Claude lines of the old shell files, with secret-looking assignments masked.
shell_claude_lines() {
  local f
  for f in "${SHELL_FILES[@]}"; do
    if [ -f "$meta/extras/shell/$f" ]; then
      grep -nE 'claude|plaude|CLAUDE|anthropic|ANTHROPIC' "$meta/extras/shell/$f" | sed "s#^#~/$f:#" || true
    fi
  done | sed -E 's/((KEY|TOKEN|SECRET|PASSWORD)[A-Za-z_]*=)[^ ;]+/\1<masked>/g'
}

item_sizes() {
  local item
  while IFS= read -r item; do
    printf '%s\t%s\n' "$(kb_of "$HOME/$item")" "$item"
  done <"$work/items" | sort -rn >"$work/sizes.tsv"
  TOTAL_KB=$(awk -F'\t' -v n="$NESTED_KB" '{ s += $1 } END { print s - n }' "$work/sizes.tsv")
}

report() {
  local kb path reason n rest_kb
  if [ "$NO_HISTORY" = 1 ]; then
    say "Settings, skills, plugins and memory; transcripts and prompt history left out (--no-history)."
  else
    say "Settings, skills, plugins, memory, transcripts and prompt history."
  fi
  say ""
  say "Packs about $(human_kb "$TOTAL_KB") before compression:"
  head -n 20 "$work/sizes.tsv" | while IFS=$'\t' read -r kb path; do
    printf '  %7s  %s\n' "$(human_kb "$kb")" "~/$path"
  done
  n=$(awk 'END { print NR - 20 }' "$work/sizes.tsv")
  if [ "$n" -gt 0 ]; then
    rest_kb=$(tail -n +21 "$work/sizes.tsv" | awk -F'\t' '{ s += $1 } END { print s + 0 }')
    printf '  %7s  … and %d smaller items\n' "$(human_kb "$rest_kb")" "$n"
  fi
  say ""
  say "Left out:"
  sort -rn "$work/skipped.tsv" | while IFS=$'\t' read -r kb path reason; do
    printf '  %7s  %-44s %s\n' "$(human_kb "$kb")" "~/$path" "$reason"
  done
  if [ -s "$work/repos.tsv" ]; then
    say ""
    say "Git repos your setup points into (the archive records where to clone them from):"
    while IFS=$'\t' read -r path remote _; do
      printf '  %-48s %s\n' "$path" "$remote"
    done <"$work/repos.tsv"
  fi
  if [ -s "$work/external.txt" ]; then
    say ""
    say "Outside the archive and outside any repo (install these on the new Mac yourself):"
    sed 's/^/  /' "$work/external.txt"
  fi
  if [ -s "$work/broken.tsv" ]; then
    say ""
    say "Links already broken on this Mac: $(awk 'END { print NR }' "$work/broken.tsv") (listed in RESTORE.md)"
  fi
  say ""
  n=$(awk 'END { print NR }' "$work/secrets.tsv")
  if [ "$n" -gt 0 ]; then
    say "Token-shaped strings in $n files (values not shown), mostly pasted into transcripts:"
    head -n 8 "$work/secrets.tsv" | awk -F'\t' '{ printf "  %s  (%s)\n", $1, $2 }'
    if [ "$n" -gt 8 ]; then say "  … see RESTORE.md in the archive for the full list"; fi
    if [ "$ENCRYPT" = 1 ]; then say "The archive is encrypted."; else say "--no-encrypt: anyone holding the archive can read these."; fi
  else
    say "No token-shaped strings found."
  fi
}

write_restore_md() {
  local archive_name=$1 kb path reason remote branch installs
  {
    printf '# Restoring your Claude setup\n\n'
    printf 'Exported from `%s` on %s with Claude Code %s. ' "$HOST" "$(date '+%Y-%m-%d %H:%M')" "$CLAUDE_VERSION"
    if [ "$NO_HISTORY" = 1 ]; then printf 'Transcripts and prompt history were left out.\n\n'; else printf 'Transcripts and prompt history included.\n\n'; fi
    cat <<EOF
## On the new Mac

1. Install Claude Code: \`curl -fsSL https://claude.ai/install.sh | bash\`
2. Restore. It asks before changing anything, and copies whatever it would overwrite to
   \`~/.local/share/claude-migrate/backups/\`:

       bash $pkgname/claude-migrate import $pkgname

   Or straight from the archive, without unpacking it first: \`bash claude-migrate import $archive_name\`
3. Log in to each profile. Logins live in the old Mac's Keychain and do not move.
EOF
    for path in $(profile_dirs); do
      if [ "$path" = .claude ]; then
        printf '   - `claude`, then `/login`\n'
      elif [ -f "$HOME/$path/.claude.json" ]; then
        printf '   - `CLAUDE_CONFIG_DIR=~/%s claude`, then `/login`\n' "$path"
      fi
    done
    cat <<'EOF'
4. Clone the repos below and run their install scripts. Several skills and plugins link into them.
5. Copy the Claude lines of your old shell config (below) into the new `~/.zshrc`.
6. Run `claude-migrate doctor` and repeat until it reports nothing missing.

Other tools keep their logins in the Keychain too (gh, glab, Codex, Antigravity):
log in to each again.

## Repos to clone

EOF
    if [ -s "$work/repos.tsv" ]; then
      printf '| Path | Clone from | Branch | Install scripts |\n| --- | --- | --- | --- |\n'
      while IFS=$'\t' read -r path remote branch installs; do
        printf '| `%s` | `%s` | %s | %s |\n' "$path" "$remote" "$branch" "$installs"
      done <"$work/repos.tsv"
      printf '\nClone each one to the same path: `git clone <remote> <path>`.\n'
    else
      printf 'None.\n'
    fi
    if [ -s "$work/external.txt" ]; then
      printf '\n## Needed, but not in the archive or any repo\n\n'
      sed 's/^/- `/; s/$/`/' "$work/external.txt"
    fi
    printf '\n## Shell\n\nThe old shell files are in `extras/shell/`, and after an import in\n'
    printf '`~/.local/share/claude-migrate/last-import/extras/shell/`. They are never installed\n'
    printf 'automatically. Lines that mention Claude (functions continue past the matched line):\n\n'
    shell_claude_lines | sed 's/^/    /'
    printf '\n## Packed\n\n'
    while IFS=$'\t' read -r kb path; do
      printf -- '- `~/%s` (%s)\n' "$path" "$(human_kb "$kb")"
    done <"$work/sizes.tsv"
    printf '\n## Left out\n\n'
    sort -rn "$work/skipped.tsv" | while IFS=$'\t' read -r kb path reason; do
      printf -- '- `~/%s` (%s): %s\n' "$path" "$(human_kb "$kb")" "$reason"
    done
    if [ -s "$work/broken.tsv" ]; then
      printf '\n## Links that were already broken on the old Mac\n\n'
      awk -F'\t' '{ printf "- `~/%s` → `%s`\n", $1, $2 }' "$work/broken.tsv"
    fi
    printf '\n## Token-shaped strings\n\n'
    if [ -s "$work/secrets.tsv" ]; then
      printf 'Files holding something shaped like a token or key (values not recorded):\n\n'
      head -n 200 "$work/secrets.tsv" | awk -F'\t' '{ printf "- `%s`: %s\n", $1, $2 }'
    else
      printf 'None found.\n'
    fi
  } >"$meta/RESTORE.md"
}

ask_passphrase() { # $1 = 1 to ask twice
  local again
  if [ -n "$PASSFILE" ]; then
    PASS=$(cat "$PASSFILE")
    [ -n "$PASS" ] || die "passphrase file is empty: $PASSFILE"
    return 0
  fi
  (: </dev/tty) 2>/dev/null || die "no terminal to ask for a passphrase; use --passphrase-file FILE"
  IFS= read -r -s -p "Passphrase: " PASS </dev/tty
  printf '\n' >&2
  [ -n "$PASS" ] || die "empty passphrase"
  if [ "$1" = 1 ]; then
    IFS= read -r -s -p "Same passphrase again: " again </dev/tty
    printf '\n' >&2
    [ "$PASS" = "$again" ] || die "the passphrases differ"
  fi
}

cmd_export() {
  local out stamp free_kb item args
  [ -z "$SRC" ] || die "export takes no argument (to choose the output directory: -o $SRC)"
  tar --version 2>/dev/null | grep -q bsdtar || die "export needs bsdtar, the tar that ships with macOS"
  [ -d "$OUTDIR" ] || die "no such directory: $OUTDIR"
  if [ "$ENCRYPT" = 1 ] && [ "$DRY" = 0 ] && [ -z "$PASSFILE" ] && ! (: </dev/tty) 2>/dev/null; then
    die "no terminal to ask for a passphrase; use --passphrase-file FILE or --no-encrypt"
  fi
  OUTDIR=$(cd "$OUTDIR" && pwd -P)
  work=$(mktemp -d "${TMPDIR:-/tmp}/claude-migrate.XXXXXX")
  trap 'rm -rf "$work"' EXIT
  HOST=$(hostname -s 2>/dev/null || echo mac)
  HOST=$(printf '%s' "$HOST" | tr -c 'A-Za-z0-9-' '-')
  CLAUDE_VERSION=$(claude --version 2>/dev/null | awk 'NR == 1 { print $1 }') || true
  CLAUDE_VERSION=${CLAUDE_VERSION:-unknown}
  stamp=$(date +%Y%m%d-%H%M)
  pkgname="claude-migration-$HOST-$stamp"
  meta="$work/$pkgname"
  mkdir -p "$meta/extras/shell"

  say "Looking at $(tildify "$HOME")…"
  collect
  if under_items "$OUTDIR/x"; then die "the output directory is inside what gets packed; pick another with -o"; fi
  discover_dependencies
  copy_shell_files
  item_sizes
  say "Scanning for token-shaped strings…"
  scan_secrets
  say ""
  report
  if [ "$DRY" = 1 ]; then
    say ""
    say "Dry run: nothing written."
    return 0
  fi

  free_kb=$(df -k "$OUTDIR" | awk 'NR == 2 { print $4 }')
  if [ "$free_kb" -lt $((TOTAL_KB / 2)) ]; then
    die "$(human_kb "$free_kb") free in $OUTDIR; the archive may need up to $(human_kb $((TOTAL_KB / 2))). Free space or use -o"
  fi
  out="$OUTDIR/$pkgname.tar.gz"
  if [ "$ENCRYPT" = 1 ]; then
    out="$out.enc"
    if [ -z "$PASSFILE" ]; then
      say ""
      say "Choose a passphrase. Without it the archive cannot be opened."
    fi
    ask_passphrase 1
  fi

  {
    printf 'FORMAT=%s\nOLD_HOME=%s\nHOST=%s\nCREATED=%s\nCLAUDE_VERSION=%s\nNO_HISTORY=%s\nTOOL_VERSION=%s\n' \
      "$FORMAT" "$HOME" "$HOST" "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$CLAUDE_VERSION" "$NO_HISTORY" "$VERSION"
  } >"$meta/manifest.env"
  cp "$work/items" "$meta/items.txt"
  cp "$work/repos.tsv" "$work/broken.tsv" "$meta/"
  cp "$work/external.txt" "$meta/external.txt"
  cp "$0" "$meta/claude-migrate"
  chmod 755 "$meta/claude-migrate"
  write_restore_md "${out##*/}"

  args=(-czf - -s ",^\./,$pkgname/home/,S" -X "$work/excludes" -C "$work" "$pkgname" -C "$HOME")
  while IFS= read -r item; do args+=("./$item"); done <"$work/items"
  say ""
  say "Packing into $(tildify "$out"). Quit other Claude sessions for a clean snapshot; this takes a few minutes…"
  if [ "$ENCRYPT" = 1 ]; then
    if ! tar "${args[@]}" 2>"$work/tar.err" |
      openssl enc -e "${CIPHER[@]}" -salt -pass fd:3 -out "$out.part" 3< <(printf '%s' "$PASS"); then
      cat "$work/tar.err" >&2
      rm -f "$out.part"
      die "packing failed; nothing written"
    fi
  elif ! tar "${args[@]}" 2>"$work/tar.err" >"$out.part"; then
    cat "$work/tar.err" >&2
    rm -f "$out.part"
    die "packing failed; nothing written"
  fi
  mv "$out.part" "$out"
  if [ -s "$work/tar.err" ]; then
    say "tar warnings (the archive was still written):"
    sed 's/^/  /' "$work/tar.err" | head -n 20
  fi
  write_readme "$out"
  say ""
  say "Done: $(tildify "$out") ($(human_kb "$(kb_of "$out")"))"
  say "      $(tildify "${out%.tar.gz*}-README.txt") says how to restore it."
  say "Copy both to the new Mac (AirDrop, USB drive)."
  if [ "$ENCRYPT" = 1 ]; then say "Keep the passphrase somewhere other than the archive, such as your password manager."; fi
}

write_readme() {
  local out=$1 name=${1##*/}
  {
    printf 'Claude Code settings and data from %s, %s.\n\n' "$HOST" "$(date '+%Y-%m-%d %H:%M')"
    printf 'On the new Mac, in the folder that holds %s:\n\n' "$name"
    printf '  1. Install Claude Code:\n       curl -fsSL https://claude.ai/install.sh | bash\n\n'
    printf '  2. Unpack it:\n'
    if [ "$ENCRYPT" = 1 ]; then
      printf '       openssl enc -d %s -in %s | tar -xzf -\n' "${CIPHER[*]}" "$name"
      printf '     (asks for the passphrase you chose when exporting)\n\n'
    else
      printf '       tar -xzf %s\n\n' "$name"
    fi
    printf '  3. Restore it, then follow the checklist it prints and %s/RESTORE.md:\n' "$pkgname"
    printf '       bash %s/claude-migrate import %s\n' "$pkgname" "$pkgname"
  } >"${out%.tar.gz*}-README.txt"
}

# ---------------------------------------------------------------------------------------- import

manifest_get() { sed -n "s/^$1=//p" "$pkg/manifest.env" | head -n 1; }

# Point everything that named the old home at the new one: file contents, link targets, and the
# project directories Claude Code names after each project's path.
rewrite_home() {
  local old=$1 new=$2 pat rep enc_old enc_new f l t d name dest
  pat=$(printf '%s' "$old" | sed 's/[][\.*^$|]/\\&/g')
  rep=$(printf '%s' "$new" | sed 's/[\&|]/\\&/g')
  say "Rewriting $old to $new…"
  { grep -rlIF --null --exclude=manifest.env -e "$old" "$pkg" 2>/dev/null || true; } | while IFS= read -r -d '' f; do
    if sed -i.cmbak "s|$pat|$rep|g" "$f" 2>/dev/null; then rm -f "$f.cmbak"; else say "  could not rewrite $f"; fi
  done
  find "$pkg/home" -type l -print0 | while IFS= read -r -d '' l; do
    t=$(readlink "$l")
    case $t in "$old" | "$old"/*) ln -sfn "$new${t#"$old"}" "$l" ;; esac
  done
  enc_old=$(encode_path "$old")
  enc_new=$(encode_path "$new")
  for d in "$pkg/home"/.claude*/projects/"$enc_old" "$pkg/home"/.claude*/projects/"$enc_old"-*; do
    if [ ! -d "$d" ] || [ -L "$d" ]; then continue; fi
    name=${d##*/}
    dest="${d%/*}/$enc_new${name#"$enc_old"}"
    if [ -e "$dest" ]; then say "  kept ${d#"$pkg"/home/}: ${dest##*/} exists too"; else mv "$d" "$dest"; fi
  done
  sed -i.cmbak "s|/projects/$enc_old\\([-/]\\)|/projects/$enc_new\\1|" "$pkg/items.txt" && rm -f "$pkg/items.txt.cmbak"
}

# Make room where the archive has a link and $HOME a real file or directory, or the reverse; bsdtar
# will not replace a non-empty directory or extract through a link. Both sides are backed up first.
clear_conflicts() {
  local item rel
  while IFS= read -r item; do
    (cd "$pkg/home" && find "./$item" \( -type l -o -type d \) -print)
  done <"$pkg/items.txt" | while IFS= read -r rel; do
    rel=${rel#./}
    if [ -L "$pkg/home/$rel" ]; then
      if [ -e "$HOME/$rel" ] && [ ! -L "$HOME/$rel" ]; then
        say "  replacing ~/$rel with a link"
        rm -rf "${HOME:?}/$rel"
      fi
    elif [ -L "$HOME/$rel" ]; then
      say "  replacing link ~/$rel with a directory"
      rm -f "${HOME:?}/$rel"
    fi
  done
}

cmd_import() {
  local stamp backup m old_home fmt item n_exist answer args p
  [ -n "$SRC" ] || die "usage: claude-migrate import ARCHIVE|DIR"
  [ -e "$SRC" ] || die "no such file or directory: $SRC"
  stamp=$(date +%Y%m%d-%H%M%S)
  STAGING="$STATE_DIR/staging-$stamp"
  backup="$STATE_DIR/backups/$stamp"
  mkdir -p "$STAGING"
  trap 'rm -rf "$STAGING"' EXIT # global: the trap fires after this function returns
  if [ -d "$SRC" ]; then
    say "Copying $SRC…"
    (cd "$SRC" && tar -cf - .) | tar -xpf - -C "$STAGING"
  else
    case $SRC in
      *.enc)
        ask_passphrase 0
        say "Decrypting and unpacking…"
        openssl enc -d "${CIPHER[@]}" -pass fd:3 -in "$SRC" 3< <(printf '%s' "$PASS") | tar -xpzf - -C "$STAGING" ||
          die "could not unpack $SRC (wrong passphrase?)"
        ;;
      *) say "Unpacking…"; tar -xpzf "$SRC" -C "$STAGING" || die "could not unpack $SRC" ;;
    esac
  fi
  pkg=
  for m in "$STAGING/manifest.env" "$STAGING"/*/manifest.env; do
    if [ -f "$m" ]; then pkg=$(dirname "$m"); break; fi
  done
  [ -n "$pkg" ] || die "$SRC is not a claude-migrate export (no manifest.env)"
  fmt=$(manifest_get FORMAT)
  [ "${fmt:-0}" -le "$FORMAT" ] || die "this export is format $fmt; this script reads up to $FORMAT. Use the claude-migrate inside the archive"
  old_home=$(manifest_get OLD_HOME)

  n_exist=0
  while IFS= read -r item; do
    if [ -e "$HOME/$item" ] || [ -L "$HOME/$item" ]; then n_exist=$((n_exist + 1)); fi
  done <"$pkg/items.txt"
  say ""
  say "Export from $(manifest_get HOST), $(manifest_get CREATED), Claude Code $(manifest_get CLAUDE_VERSION)."
  say "Restores $(awk 'END { print NR }' "$pkg/items.txt") items into $HOME; $n_exist exist already and are copied to"
  say "  $(tildify "$backup") first. Files only this Mac has are kept."
  if [ "$old_home" != "$HOME" ]; then say "Paths are rewritten from $old_home to $HOME."; fi
  if [ "$DRY" = 1 ]; then
    say "Dry run: nothing changed."
    return 0
  fi
  if [ "$YES" != 1 ]; then
    (: </dev/tty) 2>/dev/null || die "no terminal to confirm; add --yes"
    printf 'Quit every Claude Code session on this Mac first. Continue? [y/N] ' >&2
    IFS= read -r answer </dev/tty
    case $answer in y | Y | yes) ;; *) die "stopped; nothing changed" ;; esac
  fi

  if [ "$old_home" != "$HOME" ]; then rewrite_home "$old_home" "$HOME"; fi
  say "Backing up what would be overwritten…"
  while IFS= read -r item; do
    if [ -e "$HOME/$item" ] || [ -L "$HOME/$item" ]; then
      mkdir -p "$backup/$(dirname "$item")"
      cp -RPp "$HOME/$item" "$backup/$item"
    fi
  done <"$pkg/items.txt"
  clear_conflicts
  say "Restoring…"
  args=()
  while IFS= read -r item; do args+=("./$item"); done <"$pkg/items.txt"
  (cd "$pkg/home" && tar -cf - "${args[@]}") | (cd "$HOME" && tar -xpPf -) ||
    die "restoring failed part-way; what was there before is in $(tildify "$backup")"
  for p in "$pkg/home"/.claude "$pkg/home"/.claude-*; do
    if [ -d "$p" ] && [ ! -L "$p" ]; then chmod 700 "$HOME/${p##*/}"; fi # as Claude Code creates them
  done

  rm -rf "$STATE_DIR/last-import"
  mkdir -p "$STATE_DIR/last-import"
  cp -Rp "$pkg/manifest.env" "$pkg/items.txt" "$pkg/repos.tsv" "$pkg/broken.tsv" "$pkg/external.txt" \
    "$pkg/RESTORE.md" "$pkg/extras" "$STATE_DIR/last-import/"
  cp "$pkg/claude-migrate" "$STATE_DIR/claude-migrate"
  if [ ! -e "$HOME/.local/bin/claude-migrate" ]; then
    mkdir -p "$HOME/.local/bin"
    rm -f "$HOME/.local/bin/claude-migrate" # a link into a repo that is not cloned yet
    cp "$pkg/claude-migrate" "$HOME/.local/bin/claude-migrate"
    chmod 755 "$HOME/.local/bin/claude-migrate"
  fi
  say "Restored. The checklist is in $(tildify "$STATE_DIR/last-import/RESTORE.md")."
  say ""
  cmd_doctor
}

# ---------------------------------------------------------------------------------------- doctor

in_missing_repo() {
  local repo _
  if [ ! -s "$STATE_DIR/last-import/repos.tsv" ]; then return 1; fi
  while IFS=$'\t' read -r repo _; do
    repo=$(untildify "$repo")
    if [ ! -d "$repo" ]; then
      case $1 in "$repo" | "$repo"/*) return 0 ;; esac
    fi
  done <"$STATE_DIR/last-import/repos.tsv"
  return 1
}

cmd_doctor() {
  local last="$STATE_DIR/last-import" problems=0 p status path remote branch installs l t repo note c shown=0 chained
  ok() { printf '  ✓ %s\n' "$*"; }
  bad() { printf '  ✗ %s\n' "$*"; problems=$((problems + 1)); }

  say "Claude Code"
  if command -v claude >/dev/null 2>&1 || [ -x "$HOME/.local/bin/claude" ]; then
    ok "installed: $(PATH="$HOME/.local/bin:$PATH" claude --version 2>/dev/null | head -n 1)"
    for p in $(profile_dirs); do
      if [ "$p" = .claude ]; then
        status=$(env -u CLAUDE_CONFIG_DIR PATH="$HOME/.local/bin:$PATH" claude auth status 2>/dev/null) || true
      elif [ -f "$HOME/$p/.claude.json" ]; then
        status=$(CLAUDE_CONFIG_DIR="$HOME/$p" PATH="$HOME/.local/bin:$PATH" claude auth status 2>/dev/null) || true
      else
        continue
      fi
      if printf '%s' "$status" | grep -q '"loggedIn": *true'; then
        ok "~/$p logged in"
      elif [ "$p" = .claude ]; then
        bad "~/$p not logged in: run claude, then /login"
      else
        bad "~/$p not logged in: run CLAUDE_CONFIG_DIR=~/$p claude, then /login"
      fi
    done
  else
    bad "not installed: curl -fsSL https://claude.ai/install.sh | bash"
  fi

  if [ -s "$last/repos.tsv" ]; then
    say ""
    say "Repos your setup points into"
    while IFS=$'\t' read -r path remote branch installs; do
      if [ -d "$(untildify "$path")" ]; then
        ok "$path"
      else
        bad "$path missing: git clone $remote $path"
        if [ "$installs" != - ]; then printf '      then run: %s\n' "$installs"; fi
      fi
    done <"$last/repos.tsv"
  fi

  say ""
  say "Links"
  for p in $(profile_dirs) .agents .local/bin; do
    if [ -d "$HOME/$p" ]; then find "$HOME/$p" -name node_modules -prune -o -type l -print 2>/dev/null || true; fi
  done | while IFS= read -r l; do
    if [ ! -e "$l" ]; then printf '%s\t%s\n' "$l" "$(readlink "$l")"; fi
  done >"$STATE_DIR/.broken-now" || true
  chained=0
  if [ -s "$STATE_DIR/.broken-now" ]; then
    while IFS=$'\t' read -r l t; do
      # A link to another broken link (~/.claude-personal/skills/x → ~/.claude/skills/x) is fixed with it.
      if [ -L "$t" ]; then chained=$((chained + 1)); continue; fi
      note=
      if [ -s "$last/repos.tsv" ]; then
        while IFS=$'\t' read -r repo remote branch installs; do
          repo=$(untildify "$repo")
          case $t in "$repo"/*) note=" (clone $(tildify "$repo"))" ;; esac
        done <"$last/repos.tsv"
      fi
      if [ -s "$last/broken.tsv" ] &&
        awk -F'\t' -v p="${l#"$HOME"/}" '$1 == p { f = 1 } END { exit !f }' "$last/broken.tsv"; then
        note=" (already broken on the old Mac)"
      fi
      shown=$((shown + 1))
      if [ "$shown" -le 30 ]; then bad "$(tildify "$l") → $(tildify "$t")$note"; else problems=$((problems + 1)); fi
    done <"$STATE_DIR/.broken-now"
    if [ "$shown" -gt 30 ]; then printf '    … %d more\n' $((shown - 30)); fi
    if [ "$chained" -gt 0 ]; then printf '    and %d links to the links above, fixed along with them\n' "$chained"; fi
  else
    ok "every link resolves"
  fi
  rm -f "$STATE_DIR/.broken-now"

  say ""
  say "Paths your hooks, status line, MCP servers and marketplaces use"
  shown=0
  while IFS= read -r c; do
    if is_system_path "$c" || in_missing_repo "$c"; then continue; fi # the clone line covers those
    if [ ! -e "$c" ]; then bad "$(tildify "$c")"; shown=$((shown + 1)); fi
  done < <(referenced_paths)
  if [ "$shown" = 0 ]; then ok "all present"; fi

  say ""
  if [ "$problems" = 0 ]; then
    say "Nothing missing."
  else
    say "$problems things to fix."
  fi
  if [ -f "$last/RESTORE.md" ]; then
    say "Shell aliases and the rest of the checklist: $(tildify "$last/RESTORE.md")"
  fi
}

main() {
  local cmd=${1:-}
  if [ $# -gt 0 ]; then shift; fi
  OUTDIR=$HOME NO_HISTORY=0 ENCRYPT=1 PASSFILE='' DRY=0 YES=0 SRC=
  while [ $# -gt 0 ]; do
    case $1 in
      -o | --output) OUTDIR=${2:?-o needs a directory}; shift ;;
      --no-history) NO_HISTORY=1 ;;
      --no-encrypt) ENCRYPT=0 ;;
      --passphrase-file) PASSFILE=${2:?--passphrase-file needs a file}; shift ;;
      -n | --dry-run) DRY=1 ;;
      -y | --yes) YES=1 ;;
      -h | --help) usage; exit 0 ;;
      -*) die "unknown option: $1" ;;
      *) [ -z "$SRC" ] || die "unexpected argument: $1"; SRC=$1 ;;
    esac
    shift
  done
  case $cmd in
    export) cmd_export ;;
    import) cmd_import ;;
    doctor) cmd_doctor ;;
    --version | version) say "$VERSION" ;;
    '' | -h | --help | help) usage ;;
    *) die "unknown command: $cmd (export, import or doctor)" ;;
  esac
}

main "$@"
