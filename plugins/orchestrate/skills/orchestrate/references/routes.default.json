{
  "schema": "agent-executor.routes.v1",
  "note": "Defaults for each role. Override any of them in ~/.config/agent-executor/config.json (run_agent.py init writes a starter). Claude, GPT and Gemini always run in their own harness; opencode routes are for families without one (GLM, DeepSeek, Qwen, Kimi). Models are family selectors (see families.json) that resolve to the newest live ID; write an exact ID to pin one. Archetype routes keep their primary candidate in engine/model/effort and expose ordered alternates through routes.py:route_candidates.",
  "routes": {
    "implementation": {
      "engine": "codex",
      "model": "gpt:luna",
      "effort": "max"
    },
    "consultation": {
      "engine": "codex",
      "model": "gpt:sol",
      "effort": "high"
    },
    "gemini": {
      "engine": "agy",
      "model": "gemini:fast"
    },
    "claude": {
      "engine": "claude",
      "model": "claude:best",
      "effort": "high"
    },
    "opencode": {
      "engine": "opencode",
      "model": "glm:flash",
      "variant": "high"
    },
    "debug-invariants": {
      "engine": "codex",
      "model": "gpt:sol",
      "effort": "high",
      "alternates": [
        { "engine": "claude", "model": "claude:frontier", "effort": "high" },
        { "engine": "codex", "model": "gpt:luna", "effort": "max" }
      ]
    },
    "structural-refactor": {
      "engine": "claude",
      "model": "claude:frontier",
      "effort": "high",
      "alternates": [
